# ============================================================
# KG知识提取模型配置
# ============================================================
KG_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
KG_TEMPERATURE=0.7
KG_MAX_TOKENS=2048
KG_MIN_CONFIDENCE=0.6
KG_USE_NER_PREPROCESS=true
KG_USE_LLM_REFINEMENT=true

# ============================================================
# 问题生成模型配置
# ============================================================
QG_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
QG_TEMPERATURE=0.8
QG_MAX_TOKENS=1024

# ============================================================
# 问题改写模型配置
# ============================================================
QR_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
QR_TEMPERATURE=0.7
QR_MAX_TOKENS=1024

# ============================================================
# 问题评估模型配置
# ============================================================
QE_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
QE_TEMPERATURE=0.3
QE_MAX_TOKENS=512
QE_BRAND_LEAK_THRESHOLD=0.0
QE_MIN_OBJECTIVE_SCORE=60
QE_MIN_SUBJECTIVE_SCORE=60
QE_MIN_ENTITY_COVERAGE=0.1
QE_MIN_TOTAL_SCORE=60
QE_SUBJECTIVE_BATCH_SIZE=5


# ============================================================
# Embedding向量模型配置
# ============================================================
EMBEDDING_MODEL_PATH=/root/ai-models/BAAI/bge-m3


# ============================================================
# Milvus向量数据库配置
# ============================================================
# MILVUS_HOST=localhost
MILVUS_HOST=./milvus_data/milvus.db
MILVUS_PORT=19530
MILVUS_EMBEDDING_DIM=1024

# ============================================================
# 爬虫配置
# ============================================================
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_COUNT=3
CRAWLER_DELAY_MIN=1
CRAWLER_DELAY_MAX=3
CRAWLER_CACHE_ENABLED=true
CRAWLER_CACHE_PATH=data/crawled_cache
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWLER_BATCH_SIZE=50
CRAWLER_BATCH_OUTPUT_PATH=data/batch_output

# ============================================================
# 全局配置
# ============================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_RETRY_COUNT=3

# ============================================================
# GEO追踪分析配置
# ============================================================
GEO_ENABLED=true
# GEO_PLATFORMS=deepseek,qwen,kimi,doubao,yuanbao
GEO_PLATFORMS=qwen
# 是否覆盖已存在的GEO分析记录（true=覆盖，false=保留旧数据）
GEO_OVERWRITE=true
GEO_TIMEOUT=60
GEO_RETRY_COUNT=3

# GEO模型配置
SENTIMENT_MODEL_PATH=/root/ai-models/cross-encoder/nli-distilroberta-base
RECOMMENDATION_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
RECOMMENDATION_PROMPT_PATH=data/prompts/recommendation_prompt.md
RECOMMENDATION_MAX_TOKENS=2048
GEO_ANSWER_MAX_LENGTH=30000

# GEO分析LLM配置（用于精确提取各项指标）
GEO_ANALYSIS_MODEL_PATH=/root/ai-models/Qwen/Qwen2___5-7B-Instruct
GEO_ANALYSIS_TEMPERATURE=0.1
GEO_ANALYSIS_MAX_TOKENS=2048
GEO_ANALYSIS_PROMPT_PATH=data/prompts/geo_analysis_prompt.md
GEO_ANALYSIS_USE_LLM=true
GEO_ANALYSIS_FALLBACK=true

# GEO平台API Keys
DEEPSEEK_API_KEY=
# sk-6576d5eff0ab4e248563666e765ea924
QWEN_API_KEY=sk-6576d5eff0ab4e248563666e765ea924
KIMI_API_KEY=
DOUBAO_API_KEY=
YUANBAO_API_KEY=

# 各平台模型配置（可选，不配置则使用默认值）
DEEPSEEK_MODEL=deepseek-chat
QWEN_MODEL=qwen3.6-plus
QWEN_ENABLE_SEARCH=true
KIMI_MODEL=moonshot-v1-8k
DOUBAO_MODEL=doubao-pro-32k
YUANBAO_MODEL=hunyuan-lite